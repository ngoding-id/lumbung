From 0780e19529cc97031bb5acd5eacbc4053e584832 Mon Sep 17 00:00:00 2001
From: R0h1tAnand <rohitanand9419@gmail.com>
Date: Tue, 15 Sep 2026 16:27:03 +0530
Subject: [PATCH] fix: sidebar going empty from broken double-injection guard

_inject_sidebar_link() re-runs on every navigation and is meant to
inject the Computer row once, then skip via a guard comparing the
native GtkScrolledWindow's child to the wrapper we already installed.

That guard never matched: the wrapper is a GtkBox, which is not a
GtkScrollable, so gtk_scrolled_window_set_child() silently wraps it in
a GtkViewport. get_child() returned that viewport, never the wrapper,
so the name check always failed.

Each later pass then re-wrapped the sidebar, destroying the previous
wrapper and Nautilus' native listbox nested inside it (nothing else
referenced it). The next pass located a sidebar listbox again via
_find_sidebar_listbox(), but by then the only GtkListBox left with the
navigation-sidebar CSS class was our own one-row Computer listbox from
the prior pass, so it got mistaken for the native list. After 2+
passes the real bookmarks/places list is gone from the tree, leaving
only Computer row(s) -- the empty sidebar reported in #181.

- Unwrap the GtkViewport before comparing the child's name, so the
  guard actually matches and short-circuits on repeat passes.
- Exclude our own sidebar_my_computer_listbox by name in
  _find_sidebar_listbox(), so a repeat injection can never mistake its
  own widget for Nautilus' native list.

Verified with DEBUG=1 nautilus logging: before the fix,
_inject_sidebar_link ran repeatedly with the guard never matching and
bookmarks only armed on the first pass; after the fix it runs once per
window and logs 'wrapper already present, skipping' on later calls,
with bookmarks staying live.

Fixes #181
---
 nautilus_my_computer/main.py | 28 +++++++++++++++++++++++++---
 1 file changed, 25 insertions(+), 3 deletions(-)

diff --git a/nautilus_my_computer/main.py b/nautilus_my_computer/main.py
index d148916..dbd1a39 100644
--- a/nautilus_my_computer/main.py
+++ b/nautilus_my_computer/main.py
@@ -2186,16 +2186,30 @@ def _find_sidebar_listbox(self, nautilus_sidebar) -> Gtk.ListBox | None:
             )
         search_root = places_sidebar or nautilus_sidebar
 
+        # Our own injected Computer listbox also carries .navigation-sidebar, so
+        # it must never be returned here -- picking it up would make a second
+        # injection pass treat it as the native list.
+        def _is_ours(w) -> bool:
+            return w.get_name() == "sidebar_my_computer_listbox"
+
         for w in _all_widgets(search_root):
-            if isinstance(w, Gtk.ListBox) and w.has_css_class("navigation-sidebar"):
+            if (
+                isinstance(w, Gtk.ListBox)
+                and w.has_css_class("navigation-sidebar")
+                and not _is_ours(w)
+            ):
                 return w
 
         for w in _all_widgets(search_root):
-            if isinstance(w, Gtk.ListBox) and w.has_css_class("places-sidebar-list"):
+            if (
+                isinstance(w, Gtk.ListBox)
+                and w.has_css_class("places-sidebar-list")
+                and not _is_ours(w)
+            ):
                 return w
 
         for w in _all_widgets(search_root):
-            if isinstance(w, Gtk.ListBox):
+            if isinstance(w, Gtk.ListBox) and not _is_ours(w):
                 _log("_find_sidebar_listbox: no known sidebar class found, using first GtkListBox")
                 return w
         return None
@@ -2613,7 +2627,15 @@ def _inject_sidebar_link(self, win: Gtk.Window) -> bool:
             return False
 
         # Guard: skip if we already wrapped this sidebar (double-injection).
+        # The wrapper is a GtkBox, which is not a GtkScrollable, so
+        # gtk_scrolled_window_set_child() auto-creates a GtkViewport around it.
+        # get_child() therefore returns that viewport, not the wrapper, so the
+        # name has to be checked through it -- otherwise the guard never fires,
+        # every pass re-wraps, and set_child() destroys the previous wrapper
+        # together with Nautilus' native listbox inside it (empty sidebar).
         existing = native_scrolled_window.get_child()
+        if isinstance(existing, Gtk.Viewport):
+            existing = existing.get_child()
         if existing is not None and existing.get_name() == "sidebar_my_computer_wrapper":
             _log("_inject_sidebar_link: wrapper already present, skipping")
             return True
