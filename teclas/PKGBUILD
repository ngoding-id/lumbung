pkgname=teclas
pkgver=3.1.0
pkgrel=1
pkgdesc="A typing tutor application built with GTK4, Rust, and Adwaita"
arch=('x86_64')
url="https://github.com/nacho/teclas"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'gtk4' 'libadwaita')
makedepends=('cargo' 'meson' 'ninja')
source=("teclas-${pkgver}.tar.gz::https://github.com/nacho/teclas/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('261d8287c6e125337cac5aa40a16e4562278b98f907384dd08300865ab8ec5cd')
provides=('mecalin')
conflicts=('mecalin')
replaces=('mecalin')

build() {
  arch-meson "teclas-${pkgver}" build
  ninja -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
